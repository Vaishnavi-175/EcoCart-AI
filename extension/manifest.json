{
  "manifest_version": 3,
  "name": "EcoCart AI",
  "version": "4.0",
  "description": "Automatically scores clothes when you add them to a bag, finds greener alternatives, recycling tips, barcode and camera detection.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EcoCart AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}