{
  "manifest_version": 3,
  "name": "EcoCart AI",
  "version": "6.0",
  "description": "Scores clothes when you add them to a bag, detects eco-labels, filters by sustainability and budget, and tracks your impact.",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting", "alarms"],
  "host_permissions": ["https://ecocart-ai-backend.onrender.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EcoCart AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["data.js", "page.js", "sync.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}